# QueryLLM environment - copy to .env and fill in real values.
# Never commit .env with real values.

# Oracle extraction connection (notebook 01; read-only user recommended)
ORA_USER=
ORA_PASSWORD=
ORA_DSN=
PDB_NAME=

# LLM access (opencode inference endpoint, OpenAI-compatible)
# SQL_AGENT holds the API key; LLM_URL is the chat-completions endpoint
SQL_AGENT=
LLM_URL=https://opencode.ai/inference/go/openai/v1/chat/completions
LLM_MODEL=qwen3.8-flash
