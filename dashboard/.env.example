# Dashboard environment - SEPARATE from the project root .env and LLM-ONLY.
# The web pipeline never touches the database, so this server holds no
# Oracle credentials (those live in the root .env for the notebooks only).
# Never commit real values.

# LLM access (opencode inference endpoint, OpenAI-compatible)
SQL_AGENT=
LLM_URL=https://opencode.ai/inference/go/openai/v1/chat/completions
LLM_MODEL=qwen3.8-flash
