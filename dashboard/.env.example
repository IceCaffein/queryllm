# Dashboard environment - SEPARATE from the project root .env so the
# dashboard can run standalone. Copy values from the root .env (the LLM
# "SQL agent" credentials and the Oracle read-only user used by the
# validator). Never commit real values.

# Oracle connection used by the validator's read-only execution
ORA_USER=
ORA_PASSWORD=
ORA_DSN=
PDB_NAME=

# LLM access (opencode inference endpoint, OpenAI-compatible)
SQL_AGENT=
LLM_URL=https://opencode.ai/inference/go/openai/v1/chat/completions
LLM_MODEL=qwen3.8-flash
